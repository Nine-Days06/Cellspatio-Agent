# ── LLM 供应商切换 ──────────────────────────────────────────
# 修改此项即可切换供应商：deepseek / openai / zhipu
LLM_PROVIDER=deepseek

# ── DeepSeek 配置 ──────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key

# ── 智谱AI 配置 ───────────────────────────────────────────
ZHIPU_API_KEY=your_zhipu_api_key

# ── OpenAI 配置 ───────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── PubMed API 配置（可选） ────────────────────────────────
PUBMED_API_KEY=your_pubmed_api_key

# ── R 环境配置（可选） ─────────────────────────────────────
R_HOME=/usr/lib/R
