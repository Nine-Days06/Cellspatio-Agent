# ── 网络代理（可选） ────────────────────────────────────────
# PROXY=http://127.0.0.1:7890

# ── PubMed/NCBI 配置（可选） ────────────────────────────────
NCBI_API_KEY=your_ncbi_api_key
NCBI_EMAIL=your_email@example.com

# ── LLM 供应商切换 ──────────────────────────────────────────
# 修改此项即可切换供应商：deepseek / openai / zhipu（向后兼容）
LLM_PROVIDER=deepseek

# ===== 主项目（multiomics-agent）LLM 供应商 =====
# AGENT_LLM_PROVIDER=zhipu     （可选，默认 zhipu）

# ===== pubmed-etl LLM 供应商 =====
# ETL_LLM_PROVIDER=deepseek     （可选，默认 deepseek）
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT=120

# ── DeepSeek 配置 ──────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── 智谱AI 配置 ───────────────────────────────────────────
ZHIPU_API_KEY=your_zhipu_api_key
# ZHIPU_MODEL=glm-4-Flash-250414

# ── OpenAI 配置 ───────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# ── R 环境配置（可选） ─────────────────────────────────────
# R_HOME=/usr/lib/R

# ── 公共数据库配置（可选） ─────────────────────────────────
# GEO 检索复用上方 NCBI 配置
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3

# ── 按需补库（可选） ───────────────────────────────────────
# query_context 短于该长度时触发自动入库（字符数）
# LAZY_INGEST_MIN_CONTEXT=300
# 单次提问最多自动入库条数
# LAZY_INGEST_MAX_ASSETS=3
